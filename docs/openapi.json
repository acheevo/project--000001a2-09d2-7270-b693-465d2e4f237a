{
  "components": {
    "schemas": {
      "DatabaseStatus": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "string"
          },
          "reachable": {
            "type": "boolean"
          },
          "response_time": {
            "format": "int64",
            "type": "integer"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "reachable",
          "response_time"
        ],
        "type": "object"
      },
      "DependencyStatus": {
        "additionalProperties": false,
        "properties": {
          "database": {
            "$ref": "#/components/schemas/DatabaseStatus"
          }
        },
        "required": [
          "database"
        ],
        "type": "object"
      },
      "InfoResponse": {
        "additionalProperties": false,
        "properties": {
          "dependencies": {
            "$ref": "#/components/schemas/DependencyStatus"
          },
          "service": {
            "$ref": "#/components/schemas/ServiceInfo"
          },
          "system": {
            "$ref": "#/components/schemas/SystemInfo"
          },
          "timestamp": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "service",
          "system",
          "dependencies",
          "timestamp"
        ],
        "type": "object"
      },
      "ServiceInfo": {
        "additionalProperties": false,
        "properties": {
          "environment": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "uptime": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "environment",
          "instance",
          "uptime"
        ],
        "type": "object"
      },
      "SystemInfo": {
        "additionalProperties": false,
        "properties": {
          "go_version": {
            "type": "string"
          },
          "num_cpu": {
            "format": "int64",
            "type": "integer"
          },
          "num_goroutine": {
            "format": "int64",
            "type": "integer"
          },
          "platform": {
            "type": "string"
          }
        },
        "required": [
          "go_version",
          "platform",
          "num_cpu",
          "num_goroutine"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "ServiceJWT": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Contract for the typed service information endpoint.",
    "title": "Template API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/info": {
      "get": {
        "operationId": "get-service-info",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InfoResponse"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Missing or invalid bearer token"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InfoResponse"
                }
              }
            },
            "description": "A required dependency is unavailable"
          }
        },
        "security": [
          {
            "ServiceJWT": []
          }
        ],
        "summary": "Get service information",
        "tags": [
          "Service"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ]
}
